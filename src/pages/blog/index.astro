---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { url } from '../../lib/base';

const posts = (await getCollection('posts')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---
<Base title="Blog">
  <h1>Blog</h1>
  {posts.length === 0 && <p>No posts yet.</p>}
  <ul class="post-list">
    {posts.map((post) => (
      <li>
        <a class="post-row" href={url(`/blog/${post.id}`)}>
          {post.data.heroImage && <img src={post.data.heroImage} alt="" loading="lazy" />}
          <span class="post-meta">
            <span class="post-title">{post.data.title}</span>
            {post.data.author && <span class="author"> by {post.data.author}</span>}
            <time datetime={post.data.date.toISOString()}>
              {post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' })}
            </time>
          </span>
        </a>
      </li>
    ))}
  </ul>
  <style>
    .post-list { list-style: none; padding: 0; display: flex; flex-direction: column; gap: 16px; }
    .post-row { display: flex; gap: 16px; align-items: center; text-decoration: none; color: var(--ink); border: 1px solid var(--border); border-radius: 12px; padding: 12px; background: var(--panel); }
    .post-row img { width: 140px; aspect-ratio: 16 / 10; object-fit: cover; border-radius: 8px; flex-shrink: 0; }
    .post-meta { display: flex; flex-direction: column; gap: 4px; }
    .post-title { font-weight: 700; font-size: 1.05rem; }
    .author { color: var(--ink-soft); font-size: 0.9rem; }
    .post-row time { color: var(--ink-soft); font-size: 0.85rem; }
  </style>
</Base>

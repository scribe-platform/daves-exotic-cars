---
import Base from '../layouts/Base.astro';
import { url } from '../lib/base';
import { getCollection, type CollectionEntry } from 'astro:content';
import {
  CATALOG_ACTIVE_FIELD,
  CATALOG_COLLECTION,
  CATALOG_FEATURED_FIELD,
  CATALOG_LABEL,
  CATALOG_PRICE_FIELD,
  CATALOG_SORT_FIELD,
  CATALOG_TITLE_FIELD,
  SITE_NAME,
} from '../site-config';
import { formatPrice } from '../lib/catalog';

let featured: CollectionEntry<any>[] = [];
if (CATALOG_COLLECTION) {
  const entries = (await getCollection(CATALOG_COLLECTION as any)) as CollectionEntry<any>[];
  const visible = CATALOG_ACTIVE_FIELD ? entries.filter((e) => e.data[CATALOG_ACTIVE_FIELD] !== false) : entries;
  const sorted = CATALOG_SORT_FIELD
    ? [...visible].sort((a, b) => (a.data[CATALOG_SORT_FIELD] < b.data[CATALOG_SORT_FIELD] ? -1 : 1))
    : visible;
  const prioritized = CATALOG_FEATURED_FIELD
    ? [...sorted].sort((a, b) => Number(b.data[CATALOG_FEATURED_FIELD] === true) - Number(a.data[CATALOG_FEATURED_FIELD] === true))
    : sorted;
  featured = prioritized.slice(0, 3);
}
---
<Base title="Home" description={`${SITE_NAME} — managed with Scribe.`}>
  <section class="hero">
    <span class="eyebrow">Curated. Verified. Unforgettable.</span>
    <h1>Drive something extraordinary.</h1>
    <p class="hero-sub">
      {SITE_NAME} sources and hand-inspects the world's most exceptional performance cars —
      each one ready for its next owner.
    </p>
    <div class="hero-actions">
      {CATALOG_COLLECTION && (
        <a class="btn btn-primary" href={url(`/${CATALOG_COLLECTION}`)}>Browse the Collection</a>
      )}
      <a class="btn btn-secondary" href={url('/contact')}>Talk to Us</a>
    </div>
  </section>

  <section class="why-us">
    <h2>Why buyers choose us</h2>
    <div class="card-grid">
      <div class="card">
        <h3>🔑 Every car inspected</h3>
        <p>Full mechanical and cosmetic inspection before it ever reaches the showroom floor.</p>
      </div>
      <div class="card">
        <h3>📜 Verified history</h3>
        <p>Clean title, documented service records, no surprises after the sale.</p>
      </div>
      <div class="card">
        <h3>🤝 White-glove buying</h3>
        <p>Private viewings, nationwide delivery, and financing built for serious buyers.</p>
      </div>
    </div>
  </section>

  {featured.length > 0 && (
    <section class="teaser">
      <h2>Featured {CATALOG_LABEL}</h2>
      <div class="card-grid">
        {featured.map((entry) => (
          <a class="card" href={url(`/${CATALOG_COLLECTION}/${entry.id}`)}>
            <h3>{entry.data[CATALOG_TITLE_FIELD] ?? entry.id}</h3>
            {CATALOG_PRICE_FIELD && entry.data[CATALOG_PRICE_FIELD] != null && (
              <p class="price">{formatPrice(entry.data[CATALOG_PRICE_FIELD])}</p>
            )}
          </a>
        ))}
      </div>
    </section>
  )}

  <p class="managed-note">This site is managed with Scribe. Read the <a href={url('/blog')}>blog</a> or <a href={url('/contact')}>get in touch</a>.</p>

  <style>
    .hero { text-align: center; padding: 56px 0 64px; }
    .eyebrow { text-transform: uppercase; letter-spacing: 0.12em; font-size: 0.8rem; font-weight: 700; color: var(--gold-bright); }
    .hero h1 { font-size: 2.8rem; margin: 12px 0; color: var(--ink); }
    .hero-sub { max-width: 560px; margin: 0 auto 28px; color: var(--ink-soft); }
    .hero-actions { display: flex; gap: 16px; justify-content: center; flex-wrap: wrap; }
    .btn { display: inline-block; padding: 12px 24px; border-radius: 999px; font-weight: 700; text-decoration: none; }
    .btn-primary { background: var(--gold); color: #14110c; }
    .btn-secondary { background: transparent; color: var(--gold-bright); border: 1px solid var(--gold); }
    section.why-us, section.teaser { margin: 48px 0; }
    section h2 { text-align: center; margin-bottom: 24px; }
    .card-grid { display: grid; gap: 20px; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); }
    .card { display: block; border: 1px solid var(--border); border-radius: 12px; padding: 20px; background: var(--panel); color: var(--ink); text-decoration: none; }
    .card h3 { margin-top: 0; }
    .price { font-weight: 700; color: var(--gold-bright); }
    .managed-note { text-align: center; color: var(--ink-soft); font-size: 0.9rem; margin-top: 48px; }
  </style>
</Base>

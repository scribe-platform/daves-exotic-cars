---
import Base from '../layouts/Base.astro';
import ContactForm from '../components/ContactForm.astro';
import { CONTACT_COLLECTION, CONTACT_FIELDS, SITE_SLUG, TURNSTILE_SITE_KEY } from '../site-config';
---
<Base title="Contact">
  <h1>Request more information</h1>
  <p>Interested in a car, financing, or a private viewing? Tell us what you're after and we'll follow up shortly.</p>
  <ContactForm
    site={SITE_SLUG}
    collection={CONTACT_COLLECTION}
    turnstileSiteKey={TURNSTILE_SITE_KEY}
    fields={CONTACT_FIELDS.length > 0 ? CONTACT_FIELDS : undefined}
  />
</Base>

<script is:inline>
  (function () {
    const params = new URLSearchParams(window.location.search);
    const car = params.get('car');
    if (!car) return;
    const field = document.querySelector('#scribe-contact-form [name="carOfInterest"]');
    if (field) field.value = car;
  })();
</script>

---
// Generic catalog detail page — see index.astro in this folder for why this
// isn't hardcoded to any one customer's collection name.
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { url } from '../../lib/base';
import {
  CATALOG_ACTIVE_FIELD,
  CATALOG_BODY_FIELD,
  CATALOG_COLLECTION,
  CATALOG_FEATURED_FIELD,
  CATALOG_FIELDS,
  CATALOG_IMAGE_FIELD,
  CATALOG_LABEL,
  CATALOG_PRICE_FIELD,
  CATALOG_TITLE_FIELD,
} from '../../site-config';
import { formatFieldValue, formatPrice } from '../../lib/catalog';

export async function getStaticPaths() {
  if (!CATALOG_COLLECTION) return [];
  const entries = (await getCollection(CATALOG_COLLECTION as any)) as CollectionEntry<any>[];
  return entries.map((entry) => ({
    params: { collection: CATALOG_COLLECTION, slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props as { entry: CollectionEntry<any> };
const { Content } = CATALOG_BODY_FIELD ? await render(entry) : { Content: null };

const secondaryFields = CATALOG_FIELDS.filter(
  (f) =>
    f.name !== CATALOG_TITLE_FIELD &&
    f.name !== CATALOG_PRICE_FIELD &&
    f.name !== CATALOG_IMAGE_FIELD &&
    f.name !== CATALOG_FEATURED_FIELD &&
    f.name !== CATALOG_ACTIVE_FIELD,
);

const images: string[] = CATALOG_IMAGE_FIELD
  ? [].concat(entry.data[CATALOG_IMAGE_FIELD] ?? [])
  : [];
---
<Base title={entry.data[CATALOG_TITLE_FIELD] ?? entry.id}>
  <a class="back-link" href={url(`/${CATALOG_COLLECTION}`)}>&larr; Back to {CATALOG_LABEL}</a>
  <article class="catalog-detail">
    {images.length > 0 && (
      <div class="gallery">
        <div class="gallery-main"><img src={url(images[0])} alt={entry.data[CATALOG_TITLE_FIELD] ?? entry.id} /></div>
        {images.length > 1 && (
          <div class="gallery-strip">
            {images.slice(1).map((src) => <img src={url(src)} alt="" loading="lazy" />)}
          </div>
        )}
      </div>
    )}
    <h1>{entry.data[CATALOG_TITLE_FIELD] ?? entry.id}</h1>
    {CATALOG_PRICE_FIELD && entry.data[CATALOG_PRICE_FIELD] != null && (
      <p class="price">{formatPrice(entry.data[CATALOG_PRICE_FIELD])}</p>
    )}
    {secondaryFields.map((field) => (
      entry.data[field.name] != null && (
        <p class="field"><strong>{field.label}:</strong> {formatFieldValue(entry.data[field.name])}</p>
      )
    ))}
    {Content && (
      <div class="prose">
        <Content />
      </div>
    )}
    <a class="btn" href={url(`/contact?car=${encodeURIComponent(String(entry.data[CATALOG_TITLE_FIELD] ?? entry.id))}`)}>
      Request more information
    </a>
  </article>
  <style>
    .back-link { display: inline-block; margin-bottom: 16px; font-weight: 600; }
    .gallery { margin-bottom: 24px; }
    .gallery-main { aspect-ratio: 16 / 9; border-radius: 14px; overflow: hidden; background: #000; }
    .gallery-main img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .gallery-strip { display: grid; grid-template-columns: repeat(auto-fill, minmax(90px, 1fr)); gap: 8px; margin-top: 8px; }
    .gallery-strip img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; border-radius: 8px; }
    .catalog-detail .price { font-weight: 700; color: var(--gold); font-size: 1.4rem; }
    .catalog-detail .field { color: var(--ink-soft); }
    .prose { margin: 20px 0; }
    .btn {
      display: inline-block;
      margin-top: 12px;
      background: var(--gold);
      color: #14110c;
      padding: 12px 24px;
      border-radius: 999px;
      text-decoration: none;
      font-weight: 700;
    }
  </style>
</Base>

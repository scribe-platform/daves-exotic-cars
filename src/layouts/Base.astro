---
import { url } from '../lib/base';
import { CATALOG_COLLECTION, CATALOG_LABEL, SITE_NAME } from '../site-config';

export interface Props {
  title: string;
  siteName?: string;
  description?: string;
}

const { title, siteName = SITE_NAME, description } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · {siteName}</title>
    {description && <meta name="description" content={description} />}
  </head>
  <body>
    <header class="site-header">
      <a href={url('/')} class="site-name">{siteName}</a>
      <nav>
        <a href={url('/')}>Home</a>
        {CATALOG_COLLECTION && <a href={url(`/${CATALOG_COLLECTION}`)}>{CATALOG_LABEL}</a>}
        <a href={url('/events')}>Events</a>
        <a href={url('/blog')}>Blog</a>
        <a href={url('/contact')} class="nav-cta">Contact</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <p>&copy; {new Date().getFullYear()} {siteName}. Built with Scribe.</p>
    </footer>
  </body>
  <style is:global>
    :root {
      color-scheme: dark;
      --ink: #f1efe8;
      --ink-soft: #b7b0a1;
      --paper: #0c0b09;
      --panel: #17140f;
      --gold: #c9a24b;
      --gold-bright: #e4c477;
      --border: #2a251c;
    }
    * { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: system-ui, -apple-system, 'Segoe UI', sans-serif;
      color: var(--ink);
      background: var(--paper);
      line-height: 1.55;
    }
    a { color: var(--gold-bright); }
    .site-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 16px 24px;
      border-bottom: 1px solid var(--border);
      background: #0f0d0a;
      position: sticky;
      top: 0;
      z-index: 10;
    }
    .site-name { font-weight: 800; font-size: 1.15rem; letter-spacing: 0.04em; color: var(--gold-bright); text-decoration: none; text-transform: uppercase; }
    .site-header nav { display: flex; gap: 20px; align-items: center; font-weight: 600; }
    .site-header nav a { text-decoration: none; color: var(--ink); }
    .nav-cta {
      background: var(--gold);
      color: #14110c !important;
      padding: 8px 16px;
      border-radius: 999px;
    }
    main { max-width: 1080px; margin: 0 auto; padding: 32px 24px; min-height: 60vh; }
    .site-footer {
      background: #080705;
      color: var(--ink-soft);
      padding: 24px;
      text-align: center;
      margin-top: 48px;
      border-top: 1px solid var(--border);
    }
    .site-footer a { color: var(--gold-bright); }
  </style>
</html>

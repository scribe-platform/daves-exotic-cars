---
import type { ScribeField } from '../lib/scribe';

export interface Props {
  site: string;
  collection: string;
  turnstileSiteKey: string;
  fields: ScribeField[];
  submitLabel?: string;
  /** Values this page already knows, rendered hidden so the visitor doesn't retype them. */
  prefill?: Record<string, string>;
}

// GitHub Actions resolves an unset repo variable to an empty string rather than
// leaving it undefined, so `??` wouldn't fall back here — `||` is required.
const DEFAULT_API_BASE = import.meta.env.PUBLIC_SCRIBE_API_URL || 'https://scribe.weaverdigital.io';

const { site, collection, turnstileSiteKey, fields, submitLabel = 'Send', prefill = {} } = Astro.props;

// Scoped to the collection so a page can carry more than one form.
const formId = `scribe-form-${collection}`;

function labelFor(field: ScribeField): string {
  if (field.label) return field.label;
  const words = field.name
    .replace(/([a-z0-9])([A-Z])/g, '$1 $2')
    .replace(/[_-]+/g, ' ')
    .toLowerCase();
  return words.charAt(0).toUpperCase() + words.slice(1);
}

// The control comes from the declared type. A name match only picks the
// keyboard hint for an email/phone input — never whether a field is required.
function inputType(field: ScribeField): string {
  if (field.type === 'number') return 'number';
  if (field.type === 'date') return 'date';
  if (/mail/i.test(field.name)) return 'email';
  if (/phone|mobile|tel|cell/i.test(field.name)) return 'tel';
  return 'text';
}
---
<form id={formId} data-site={site} data-collection={collection} data-endpoint={`${DEFAULT_API_BASE}/api/submissions`} data-scribe-retry>
  {fields.map((field) =>
    prefill[field.name] !== undefined ? (
      <input type="hidden" name={field.name} value={prefill[field.name]} />
    ) : field.type === 'boolean' ? (
      <label class="checkbox">
        <input name={field.name} type="checkbox" />
        <span>{labelFor(field)}</span>
      </label>
    ) : field.type === 'text' || field.type === 'rich-text' ? (
      <label>
        {labelFor(field)}
        <textarea name={field.name} required={field.required} rows="4"></textarea>
      </label>
    ) : field.type === 'select' ? (
      <label>
        {labelFor(field)}
        <select name={field.name} required={field.required}>
          <option value="">Choose…</option>
          {(field.options ?? []).map((opt) => {
            const value = typeof opt === 'string' ? opt : opt.value;
            const text = typeof opt === 'string' ? opt : (opt.label ?? opt.value);
            return <option value={value}>{text}</option>;
          })}
        </select>
      </label>
    ) : (
      <label>
        {labelFor(field)}
        <input name={field.name} type={inputType(field)} required={field.required} />
      </label>
    ),
  )}
  <div class="cf-turnstile" data-sitekey={turnstileSiteKey}></div>
  <button type="submit">{submitLabel}</button>
  <p class="form-status" role="status" aria-live="polite"></p>
</form>

<style>
  form { display: flex; flex-direction: column; gap: 14px; max-width: 480px; margin-top: 24px; }
  form label { display: flex; flex-direction: column; gap: 4px; font-weight: 600; }
  form label.checkbox { flex-direction: row; align-items: center; gap: 8px; }
  form label.checkbox input { width: auto; }
  form input, form textarea, form select {
    font: inherit;
    padding: 10px 12px;
    border: 1px solid var(--border, #2a251c);
    border-radius: 8px;
    background: var(--panel, #17140f);
    color: var(--ink, #f1efe8);
  }
  form button {
    align-self: flex-start;
    background: var(--gold, #c9a24b);
    color: #14110c;
    border: none;
    padding: 12px 24px;
    border-radius: 999px;
    font-weight: 700;
    cursor: pointer;
  }
  form button[disabled] { opacity: 0.6; cursor: default; }
  .form-status:empty { display: none; }
</style>

<script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
<script is:inline define:vars={{ formId }}>
  (function () {
    const form = document.getElementById(formId);
    if (!form) return;
    const statusEl = form.querySelector('.form-status');
    const button = form.querySelector('button[type=submit]');
    const say = (message) => {
      if (statusEl) statusEl.textContent = message;
    };

    const { site, collection, endpoint } = form.dataset;

    // RFC 0024 — a submission the server never received is kept here and
    // replayed on the next page load, so a visitor is never told their enquiry
    // sent when it did not. The <form> declares this with data-scribe-retry;
    // the two belong together and must not separate.
    const storageKey = `scribe_pending_submission_${site}_${collection}`;

    const readPending = () => {
      try {
        const raw = localStorage.getItem(storageKey);
        return raw ? JSON.parse(raw) : null;
      } catch {
        return null;
      }
    };
    const savePending = (payload) => {
      try {
        localStorage.setItem(storageKey, JSON.stringify(payload));
      } catch {
        // localStorage unavailable (private browsing, quota). The status
        // message is already honest; there is nothing more to persist.
      }
    };
    const clearPending = () => {
      try {
        localStorage.removeItem(storageKey);
      } catch {
        // see savePending
      }
    };

    // Last resorts only. The endpoint puts visitor-facing copy in the response
    // body (RFC 0004), so the server's message beats anything generic here.
    const UNREACHABLE = "We couldn't send that yet — it's saved and will retry.";
    const GENERIC = "Sorry — we couldn't send that. Please try again.";

    // Built per control rather than from FormData, so a checkbox sends a real
    // boolean and an unchecked box sends `false` instead of being left out.
    function collect() {
      const payload = {};
      for (const el of form.elements) {
        if (!el.name) continue;
        if (el.type === 'checkbox') payload[el.name] = el.checked;
        else if (el.type === 'number') payload[el.name] = el.value === '' ? null : Number(el.value);
        else payload[el.name] = el.value;
      }
      return payload;
    }

    async function send(payload) {
      const url =
        `${endpoint}?site=${encodeURIComponent(site)}` +
        `&collection=${encodeURIComponent(collection)}`;
      const res = await fetch(url, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });
      if (res.ok) return;
      // A non-2xx means the server answered and said why, which is a different
      // thing from never reaching it. `answered` picks whose copy the visitor
      // reads; `retryable` decides whether a later attempt could plausibly land.
      const data = await res.json().catch(() => ({}));
      const error = new Error((data.error ?? '').trim() || GENERIC);
      error.answered = true;
      error.retryable = res.status >= 500;
      throw error;
    }

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const payload = collect();

      button.disabled = true;
      say('Sending…');
      try {
        await send(payload);
        clearPending();
        form.reset();
        say('Thanks — we\u2019ve got you down.');
      } catch (err) {
        // Never claim a success the server didn't give, and never paper over
        // its message with ours.
        if (err.answered) {
          if (err.retryable) savePending(payload);
          say(err.message);
        } else {
          savePending(payload);
          say(UNREACHABLE);
        }
        // A Turnstile token is single-use, so without a reset the retry we just
        // invited would send a spent token and fail no matter what.
        window.turnstile?.reset();
      }
      button.disabled = false;
    });

    // Replay on the next page load, which is what makes the queue worth having.
    (async function retryPending() {
      const pending = readPending();
      if (!pending) return;
      try {
        await send(pending);
        clearPending();
        say('Thanks — we\u2019ve got you down.');
      } catch (err) {
        // Replaying a rejection (a stale Turnstile token, a validation error)
        // on every page load would loop forever, so drop it and show what the
        // server said. Anything else stays queued for next time.
        if (err.answered && !err.retryable) {
          clearPending();
          say(err.message);
        }
      }
    })();
  })();
</script>
